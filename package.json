{
  "name": "pi-brief",
  "version": "0.3.17",
  "description": "A live session brief for Pi",
  "type": "module",
  "license": "MIT",
  "author": "Nittarab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nittarab/pi-brief.git"
  },
  "keywords": ["pi-package", "pi-extension", "pi", "session", "summary"],
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE"],
